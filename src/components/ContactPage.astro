---
import Base from "../layouts/Base.astro";
import ContactSection from "./home/ContactSection.astro";
import Team from "./Team.astro";
import { dict, type Locale } from "../i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = dict[locale];
---
<Base locale={locale} path="/contact/" title={t.meta.contact.title} description={t.meta.contact.description}>
  <ContactSection locale={locale} page />
  <Team locale={locale} />
</Base>
