---
import Logo from "./Logo.astro";
import { site } from "../data/site";
import { dict, localePath, fmt, type Locale } from "../i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = dict[locale];
const home = localePath(locale, "/");
const ph = site.contactPlaceholder;
---
<footer class="site-footer">
  <div class="container">
    <div class="bar" aria-hidden="true"></div>
    <div class="cols">
      <div class="about">
        <Logo a={site.wordmark.a} b={site.wordmark.b} sub={site.tagline} tagline size={40} />
        <p class="tagline display">{t.footer.tagline}</p>
        <p class="made">{t.footer.madeFor}</p>
      </div>
      <div class="col">
        <h2 class="mark small">{t.footer.product}</h2>
        <ul>
          <li><a href={`${home}#how`}>{t.nav.how}</a></li>
          <li><a href={`${home}#features`}>{t.nav.features}</a></li>
          <li><a href={`${home}#deliverables`}>{t.nav.deliverables}</a></li>
          <li><a href={`${home}#who`}>{t.nav.who}</a></li>
          <li><a href={localePath(locale, "/app/")}>{t.nav.app}</a></li>
        </ul>
      </div>
      <div class="col">
        <h2 class="mark small">{t.footer.company}</h2>
        <ul>
          <li><a href={localePath(locale, "/contact/")}>{t.nav.contact}</a></li>
          <li>{ph ? <span class="tbc"><span dir="ltr">{site.contact.email}</span> · {t.common.tbc}</span> : <a href={`mailto:${site.contact.email}`} dir="ltr">{site.contact.email}</a>}</li>
          <li>{ph ? <span class="tbc"><span dir="ltr">{site.contact.phone}</span> · {t.common.tbc}</span> : <a href={site.contact.phoneHref} dir="ltr">{site.contact.phone}</a>}</li>
          <li><span>{site.contact.city[locale]}</span></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>{fmt(t.footer.legal, { year: site.legal.year, company: site.legal.company[locale] })}</span>
    </div>
  </div>
</footer>
<style>
  .site-footer { padding: 3.5rem 0 2rem; border-top: 1px solid var(--line); background: var(--ground-2); }
  .cols { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 2.5rem; margin-top: 2.5rem; }
  .about { max-width: 36ch; }
  .tagline { font-size: clamp(1.6rem, 2.6vw, 2.2rem); margin: 1rem 0 0.6rem; line-height: 1; }
  html[lang="ar"] .tagline { line-height: 1.4; }
  .made { color: var(--muted); font-size: 0.9rem; margin: 0; }
  .col h2 { color: var(--muted); font-size: 0.78rem; letter-spacing: 0.14em; margin-bottom: 0.9rem; }
  .col ul { display: grid; gap: 0.5rem; }
  .col a { color: var(--ink-2); text-decoration: none; }
  .col a:hover { color: var(--green); text-decoration: underline; }
  .legal { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }
  .legal a { color: var(--muted); }
  .col .tbc { color: var(--muted); }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
