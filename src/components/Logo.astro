---
/** Wordmark with the QSAI mark (white tile, three rising green bars, gold baseline, gold spark). */
interface Props { size?: number; tone?: "dark" | "light"; tagline?: boolean; sub: string; a: string; b: string; }
const { size = 34, tone = "dark", tagline = false, sub, a, b } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
---
<span class:list={["brand", tone]} aria-label={`${a} ${b}`}>
  <svg class="brand-mark" width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
    <defs>
      <linearGradient id={`g${uid}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f3dc8a"/><stop offset=".55" stop-color="#d4ac34"/><stop offset="1" stop-color="#a8821c"/></linearGradient>
      <linearGradient id={`n${uid}`} x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#005a2c"/><stop offset="1" stop-color="#0b8a46"/></linearGradient>
    </defs>
    <rect x="1" y="1" width="38" height="38" rx="10.5" fill="#fff" stroke={`url(#g${uid})`} stroke-width="1.6"/>
    <rect x="9" y="21" width="5.6" height="10" rx="1.6" fill={`url(#n${uid})`}/>
    <rect x="17.2" y="15.5" width="5.6" height="15.5" rx="1.6" fill={`url(#n${uid})`}/>
    <rect x="25.4" y="9" width="5.6" height="22" rx="1.6" fill={`url(#n${uid})`}/>
    <rect x="8" y="32.4" width="24" height="1.8" rx=".9" fill={`url(#g${uid})`}/>
    <path d="M12 6.2c.5 3.1 1.4 4 4.5 4.5-3.1.5-4 1.4-4.5 4.5-.5-3.1-1.4-4-4.5-4.5 3.1-.5 4-1.4 4.5-4.5z" fill={`url(#g${uid})`}/>
  </svg>
  <span class="brand-text">
    <span class="brand-name"><span class="a">{a}</span><span class="b">{b}</span></span>
    {tagline && <span class="brand-tag">{sub}</span>}
  </span>
</span>
<style>
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); text-decoration: none; }
  .brand.light { color: #fff; }
  .brand-mark { flex: none; filter: drop-shadow(0 1px 1px rgba(20,38,27,.12)); }
  .brand-text { display: flex; flex-direction: column; line-height: 1; }
  .brand-name { font-family: "Big Shoulders Display", var(--font-display); font-weight: 800; font-size: 1.5rem; letter-spacing: 0.02em; text-transform: uppercase; white-space: nowrap; direction: ltr; }
  .brand-name .b { color: var(--gold-3); margin-inline-start: 0.3em; font-weight: 600; }
  .brand.light .b { color: var(--gold-2); }
  .brand-tag { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-top: 0.35em; font-weight: 500; direction: ltr; }
  .brand.light .brand-tag { color: rgba(255,255,255,.65); }
</style>
