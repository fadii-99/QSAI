---
import { dict, type Locale } from "../../i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = dict[locale];
const n = t.numbers;
---
<section class="section numbers band-white" id="numbers">
  <div class="container">
    <div class="section-head">
      <h2 class="h2" data-reveal>{n.heading}</h2>
      <p class="sub" data-reveal style="--i:1">{n.sub}</p>
    </div>
    <ul class="pairs">
      {n.pairs.map((p, i) => (
        <li class="pair tag" data-reveal style={`--i:${i + 1}`}>
          <span class="k mark small">{p.k}</span>
          <div class="vals">
            <span class="lbl">{n.before}</span><span aria-hidden="true"></span><span class="lbl">{n.after}</span>
            <s class="num before" dir="ltr">{p.before}</s>
            <svg class="ico arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            <strong class="num after" dir="ltr">{p.after}</strong>
          </div>
          <p class="note small">{p.note}</p>
        </li>
      ))}
    </ul>
    <div class="wrap" data-reveal style="--i:2">
      <table class="claims">
        <thead>
          <tr><th scope="col">{n.cols.metric}</th><th scope="col">{n.cols.figure}</th><th scope="col">{n.cols.method}</th></tr>
        </thead>
        <tbody>
          {n.rows.map((r) => (
            <tr>
              <th scope="row">{r.metric}</th>
              <td data-label={n.cols.figure} class="fig">{r.figure}</td>
              <td data-label={n.cols.method}>{r.method}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
<style>
  .pairs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .pair { display: grid; grid-template-areas: "k" "vals" "note"; gap: 0.8rem; align-content: start; padding-inline-start: 1.6rem; }
  .pair .k { grid-area: k; color: var(--muted); letter-spacing: .1em; }
  /* Labels share one row, figures share one baseline; the two columns read as a before/after pair. */
  .vals { grid-area: vals; display: grid; grid-template-columns: auto auto auto; justify-content: start; column-gap: 0.75rem; row-gap: 0.3rem; align-items: baseline; }
  .vals .ico { color: var(--gold-3); flex: none; align-self: center; }
  [dir="rtl"] .vals .ico.arrow { transform: scaleX(-1); }
  .lbl { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; align-self: end; }
  html[lang="ar"] .lbl { text-transform: none; letter-spacing: 0; }
  .before { font-family: var(--font-display); font-size: clamp(1.2rem, 1.8vw, 1.5rem); white-space: nowrap; font-weight: 700; line-height: 1; color: var(--steel-hi); text-decoration-thickness: 2px; text-decoration-color: var(--err); }
  .after { font-family: var(--font-display); font-size: clamp(1.9rem, 2.8vw, 2.5rem); white-space: nowrap; font-weight: 800; line-height: 1; color: var(--green); }
  html[lang="ar"] .before, html[lang="ar"] .after { line-height: 1.3; }
  .note { grid-area: note; margin: 0; color: var(--ink-2); }
  .wrap { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-tag); overflow: hidden; }
  .claims { width: 100%; border-collapse: collapse; }
  .claims th, .claims td { padding: 1rem 1.1rem; text-align: start; vertical-align: top; border-bottom: 1px solid var(--line); }
  .claims thead th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: .06em; font-weight: 500; color: var(--muted); background: var(--ground); border-bottom: 1px solid var(--line-strong); }
  html[lang="ar"] .claims thead th { text-transform: none; letter-spacing: 0; font-size: 0.85rem; }
  .claims tbody th { font-weight: 500; color: var(--ink); width: 22%; font-size: 0.95rem; background: var(--ground); }
  .claims td { color: var(--ink-2); font-size: 0.95rem; }
  .claims td.fig { color: var(--ink); font-weight: 400; background: var(--green-soft); width: 34%; }
  .claims tbody tr:last-child th, .claims tbody tr:last-child td { border-bottom: 0; }
  /* Tablet: one pair per row, label and note on the left, the figures on the right. */
  @media (max-width: 900px) {
    .pairs { grid-template-columns: 1fr; gap: 0.75rem; }
    .pair { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "k vals" "note vals"; column-gap: 1.5rem; row-gap: 0.4rem; align-items: center; }
    .vals { justify-self: end; }
  }
  @media (max-width: 600px) {
    .pair { grid-template-columns: 1fr; grid-template-areas: "k" "vals" "note"; row-gap: 0.7rem; }
    .vals { justify-self: start; }
  }
  @media (max-width: 760px) {
    .claims thead { display: none; }
    .claims, .claims tbody { display: block; }
    .claims tr { display: grid; grid-template-columns: 1fr; border-bottom: 6px solid var(--ground); }
    .claims tr:last-child { border-bottom: 0; }
    .claims tbody th { width: auto; font-family: var(--font-display); font-size: 1.1rem; text-transform: var(--display-case); font-weight: 600; border-bottom: 0; padding-bottom: 0.3rem; }
    .claims td, .claims td.fig { width: auto; padding: 0.6rem 1.1rem; }
    .claims td::before { content: attr(data-label); display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 0.15rem; }
    html[lang="ar"] .claims td::before { text-transform: none; letter-spacing: 0; }
  }
</style>
