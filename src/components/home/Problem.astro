---
import { dict, type Locale } from "../../i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = dict[locale];
---
<section class="section problem" id="why">
  <div class="container">
    <div class="layout">
      <div class="intro">
        <h2 class="h2" data-reveal>{t.problem.heading}</h2>
        <p class="sub" data-reveal style="--i:1">{t.problem.sub}</p>
        <div class="pull tag" data-reveal style="--i:2">
          <p class="pull-text">{t.problem.pull}</p>
        </div>
      </div>
      <ol class="ledger">
        {t.problem.cards.map((c, i) => (
          <li class="row" data-reveal style={`--i:${i + 1}`}>
            <span class="bar thin" aria-hidden="true"></span>
            <h3 class="h3">{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .intro { position: sticky; top: calc(var(--header-h) + 24px); }
  .intro .sub { margin-top: 0.8rem; }
  .pull { margin-top: 2rem; max-width: 46ch; }
  .pull-text { margin: 0; font-size: 1.1rem; line-height: 1.6; color: var(--ink); font-weight: 400; }
  html[lang="ar"] .pull-text { line-height: 1.9; }
  .ledger { display: grid; gap: clamp(1.4rem, 3vw, 2.4rem); }
  .row { display: grid; gap: 0.6rem; padding-top: 1.1rem; }
  .row .bar { margin-bottom: 0.6rem; }
  .row p { margin: 0; color: var(--ink-2); max-width: 56ch; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } .intro { position: static; } }
</style>
