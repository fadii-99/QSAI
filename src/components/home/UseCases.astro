---
import { dict, type Locale } from "../../i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = dict[locale];
---
<section class="section uses" id="use-cases">
  <div class="container">
    <h2 class="h2 head" data-reveal>{t.useCases.heading}</h2>
    <ul class="list">
      {t.useCases.items.map((u, i) => (
        <li data-reveal style={`--i:${i % 3}`}>
          <span class="end" aria-hidden="true"></span>
          <div><h3 class="h3">{u.title}</h3><p>{u.text}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .head { margin-bottom: 2rem; }
  .list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .list li { display: grid; grid-template-columns: 14px 1fr; gap: 1.1rem; background: var(--white); padding: 1.3rem 1.3rem 1.3rem 0; position: relative; transition: background .25s, box-shadow .3s var(--ease-out), transform .3s var(--ease-out); }
  [dir="rtl"] .list li { padding: 1.3rem 0 1.3rem 1.3rem; }
  .list li:hover { background: #fbfbfa; z-index: 1; box-shadow: var(--shadow-lift); transform: translateY(-2px); }
  .end { display: block; background: repeating-linear-gradient(180deg, var(--steel) 0 7px, var(--steel-hi) 7px 9px); position: relative; margin: -1.3rem 0; }
  .end::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 26px; background: var(--green); }
  .list li:nth-child(3n+2) .end::before { background: var(--gold); }
  .list li:nth-child(3n) .end::before { background: var(--green-3); }
  .list .h3 { font-size: 1.15rem; }
  .list p { margin: 0.4rem 0 0; color: var(--ink-2); font-size: 0.95rem; }
  @media (max-width: 900px) { .list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .list { grid-template-columns: 1fr; } }
</style>
