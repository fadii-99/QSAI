---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { dirOf, localePath, otherLocale, type Locale } from "../i18n";
interface Props { locale: Locale; path: string; title: string; description: string; noindex?: boolean; }
const { locale, path, title, description, noindex = false } = Astro.props;
const dir = dirOf(locale);
const other = otherLocale(locale);
const canonical = `${site.origin}${localePath(locale, path)}`;
const alternate = `${site.origin}${localePath(other, path)}`;
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#006c35" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={`${site.origin}${path}`} />
    <link rel="preload" href={`/fonts/IBMPlexSansArabic-${locale === "ar" ? "arabic" : "latin"}-400.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`/fonts/IBMPlexSansArabic-${locale === "ar" ? "arabic" : "latin"}-700.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "ar" ? "ar_SA" : "en_US"} />
    <meta property="og:site_name" content={site.name} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "SoftwareApplication", name: site.name,
      applicationCategory: "BusinessApplication", operatingSystem: "Web", description, url: canonical,
      inLanguage: locale, offers: { "@type": "Offer", availability: "https://schema.org/PreOrder" },
    })} />
  </head>
  <body>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import { mountReveals } from "../scripts/motion";
      import { applySavedLang } from "../scripts/lang";
      applySavedLang(document.documentElement.lang as "en" | "ar", location.pathname);
      mountReveals();
    </script>
  </body>
</html>
